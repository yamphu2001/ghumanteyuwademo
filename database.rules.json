{
  "rules": {

    "rouletteStock": {
      "$eventId": {
        ".read":  "auth != null",
        ".write": false
      }
    },

    "eventsProgress": {
      "$eventId": {
        "$uid": {
          ".read":  "auth != null && (auth.uid == $uid || auth.token.admin == true)",
          ".write": "auth != null && (auth.uid == $uid || auth.token.admin == true)"
        }
      }
    },

    "$other": {
      ".read":  false,
      ".write": false
    }
  }
}
