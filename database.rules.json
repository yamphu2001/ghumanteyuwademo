{
  "rules": {

    "rouletteStock": {
      "$eventId": {
        ".read":  "auth != null",
        ".write": "auth != null"
      }
    },

    "eventsProgress": {
      "$eventId": {
        "$uid": {
          ".read":  "auth != null && auth.uid == $uid",
          ".write": "auth != null && auth.uid == $uid"
        }
      }
    },

    "$other": {
      ".read":  false,
      ".write": false
    }
  }
}
